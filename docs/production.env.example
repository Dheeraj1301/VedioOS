# Copy to the deployment platform's private environment; never commit the filled file.
DEBUG=false
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://server-role.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SCHEMA=vedioos
POSTGRES_SSLROOTCERT=/run/secrets/supabase-ca.crt
DATABASE_CONN_MAX_AGE=0

SUPABASE_PROJECT_REF=lmwvoniiykmfzuxigzqf
SUPABASE_AUTH_URL=https://lmwvoniiykmfzuxigzqf.supabase.co
SUPABASE_AUTH_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-revocable-server-secret
SUPABASE_AUTH_PASSWORD_LOGIN_ENABLED=true
SUPABASE_DELETION_SYNC_ENABLED=true
SUPABASE_AUTH_TIMEOUT_SECONDS=10

S3_ENDPOINT_URL=https://private-storage.example.com
S3_REGION=replace-with-storage-region
S3_BUCKET=replace-with-private-versioned-bucket
S3_ACCESS_KEY=replace-with-restricted-server-access-key
S3_SECRET_KEY=replace-with-restricted-server-secret
UPLOAD_TTL_SECONDS=900
DOWNLOAD_TTL_SECONDS=60

# Safe limited launch: checkout stays unavailable until production pricing and
# a production payment adapter are approved and implemented.
PAYMENT_MODE=disabled
PAYOUT_MODE=disabled

# In-app notifications remain available with this disabled. Enable only after
# configuring the approved provider and verified sender below.
NOTIFICATION_EMAIL_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=BRIO <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-provider-user
EMAIL_HOST_PASSWORD=replace-with-provider-secret
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
