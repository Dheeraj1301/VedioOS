{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/internal/security-monitor/",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/internal/expire-unpaid-projects/",
      "schedule": "30 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
