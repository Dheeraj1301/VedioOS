DEBUG=true
SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Team previews should set this to true after adding the shared Supabase URL/ref.
SHARED_PREVIEW_REQUIRED=false
SUPABASE_PROJECT_REF=
SUPABASE_AUTH_URL=
# Public browser-safe project key; never put a secret/service-role key here.
SUPABASE_AUTH_PUBLISHABLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=10
SUPABASE_AUTH_PASSWORD_LOGIN_ENABLED=false
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=vedioos-private
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
# Local technical defaults, not finalized commercial upload policy.
UPLOAD_TTL_SECONDS=900
DOWNLOAD_TTL_SECONDS=60
PAYMENT_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1
PAYOUT_MODE=disabled
# Local verification links print in the runserver terminal. Configure an approved
# production email backend and verified sender domain before launch.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=VedioOS <no-reply@localhost>
# For real delivery, use django.core.mail.backends.smtp.EmailBackend and values
# supplied by the approved SMTP provider. Never commit the password/API key.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
# Development sandbox only; never use a real provider key here.
# SANDBOX_PAYMENT_SECRET=generate-a-random-server-only-secret-of-at-least-32-characters
# Production requires DEBUG=false, HTTPS and PostgreSQL.
# POSTGRES_DB=vedioos
# POSTGRES_USER=replace-me
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Supabase PostgreSQL (server-only). Use the Session pooler on port 5432.
# DATABASE_URL=postgresql://vedioos_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_SCHEMA=vedioos
# POSTGRES_SSLROOTCERT=path/to/trusted-ca.pem
